<mah:MetroWindow
    x:Class="StandardLicensingGenerator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StandardLicensingGenerator"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mahicon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Standard Licensing Generator"
    Width="800"
    Height="720"
    MinWidth="475"
    MinHeight="475"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="True"
    mc:Ignorable="d">
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Click="LaunchProjectOnGitHub" ToolTip="StandardLicensingGenerator on GitHub">
                <mahicon:PackIconMaterial
                    Width="22"
                    Height="22"
                    Kind="Github" />
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Command="{Binding SaveLicenseCommand}" Header="Save License" />
                <Separator />
                <MenuItem Click="Exit_Click" Header="Exit" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Click="ShowHelp_Click" Header="Help _Contents (F1)" />
                <MenuItem Click="ShowAbout_Click" Header="_About" />
            </MenuItem>
        </Menu>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Form contents  -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="License Details" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Template:" />
                    <Grid Grid.Column="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="TemplateBox"
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            ItemsSource="{Binding Templates}"
                            SelectedItem="{Binding SelectedTemplate}"
                            Tag="NoPersist"
                            Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                            TextSearch.TextPath="Name"
                            ToolTip="Select a template to fill the form, or type a new name and click Save Template." />
                        <Button
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Padding="5"
                            Command="{Binding SaveTemplateCommand}"
                            Content="Save _Template" />
                        <Button
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            Padding="5"
                            Command="{Binding DeleteTemplateCommand}"
                            Content="De_lete" />
                    </Grid>
                </Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Product Name:" />
                    <TextBox
                        x:Name="ProductNameBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Version:" />
                    <TextBox
                        x:Name="VersionBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="License Type:" />
                    <ComboBox
                        x:Name="LicenseTypeBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,2"
                        ItemsSource="{Binding LicenseTypes}"
                        SelectedItem="{Binding LicenseType}" />
                    <!--  "Custom" license type: TODO  -->

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Expiration Date:" />
                    <Grid
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ValidityBox"
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            IsEditable="True"
                            ItemsSource="{Binding ValidityPresets}"
                            Tag="NoPersist"
                            Text="{Binding ValidityText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Pick or type a validity period (e.g. 45 days, 1 month, 5 years). The expiration date is computed from today; you can still edit the date directly." />
                        <DatePicker
                            x:Name="ExpirationPicker"
                            Grid.Column="1"
                            SelectedDate="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Customer Name:" />
                    <TextBox
                        x:Name="CustomerNameBox"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Customer Email:" />
                    <TextBox
                        x:Name="CustomerEmailBox"
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,2"
                        Text="{Binding CustomerEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Additional Attributes (json):" />
                    <TextBox
                        x:Name="AttributesBox"
                        Grid.Row="6"
                        Grid.Column="1"
                        Height="60"
                        Margin="0,2"
                        AcceptsReturn="True"
                        Text="{Binding AttributesJson, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Private Key File:" />
                    <Grid
                        Grid.Row="7"
                        Grid.Column="1"
                        Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="KeyFileBox"
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            Text="{Binding KeyFilePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Margin="5"
                            Padding="5"
                            Command="{Binding BrowseKeyCommand}"
                            Content="_Browse" />
                        <Button
                            Grid.Column="2"
                            Margin="5"
                            Padding="5"
                            Click="OpenKeyPairGenerator_Click"
                            Content="Generate Key _Pair" />
                    </Grid>
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Margin="0,2"
                        Text="Password:" />
                    <Grid
                        Grid.Row="8"
                        Grid.Column="1"
                        Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="PasswordBox"
                            Grid.Column="0"
                            Margin="0,0,10,0" />

                        <TextBox
                            x:Name="PasswordTextBox"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Tag="NoPersist" />
                        <Button
                            x:Name="ShowPasswordButton"
                            Grid.Column="1"
                            Padding="5"
                            Content="Sho_w" />
                    </Grid>
                    <Button
                        Grid.Row="9"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Width="150"
                        Margin="0,10,0,0"
                        Padding="5"
                        HorizontalContentAlignment="Center"
                        Command="{Binding GenerateLicenseCommand}"
                        Content="_Generate License"
                        IsDefault="True" />
                </Grid>
            </StackPanel>
            <!--  ResultBox  -->
            <TextBox
                x:Name="ResultBox"
                Grid.Row="1"
                Margin="0,10,0,0"
                VerticalAlignment="Stretch"
                AcceptsReturn="True"
                IsReadOnly="True"
                Tag="NoPersist"
                Text="{Binding ResultText, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    Width="150"
                    Margin="0,10,0,0"
                    Padding="5"
                    HorizontalContentAlignment="Center"
                    Command="{Binding SaveLicenseCommand}"
                    Content="_Save License" />
                <Button
                    Grid.Column="2"
                    Width="150"
                    Margin="0,10,0,0"
                    Padding="5"
                    HorizontalContentAlignment="Center"
                    Click="CopyResultToClipboard_Click"
                    Content="_Copy to Clipboard" />
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>