<mah:MetroWindow
    x:Class="StandardLicensingGenerator.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Width="780"
    Height="585"
    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="15"
            Background="{DynamicResource MahApps.Brushes.Accent}">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Standard Licensing Generator Help" />
        </Border>

        <!--  Content  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!--  Overview Section  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="Overview" />
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            This tool creates licenses compatible with the Standard.Licensing library. It allows you to generate,
                            sign, and save license files that can be validated in your applications.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  Basic Usage Section  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="Basic Usage" />
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">1.</Run>
                            Enter your product details and customer information.</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">2.</Run>
                            Select the desired license type (Standard, Trial, or Custom).</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">3.</Run>
                            Set the expiration date: pick or type a validity period (e.g. 45 days, 1 month, 5 years)
                            to compute the date from today, or edit the date directly in the date picker.</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">4.</Run>
                            Add extra attributes in JSON format if needed (e.g. { "Seats": "5" }).</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">5.</Run>
                            Browse to select your RSA private key file (PEM or XML format).</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">6.</Run>
                            Click <Run FontWeight="SemiBold">Generate License</Run>
                            to create the license.</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">7.</Run>
                            Use <Run FontWeight="SemiBold">File → Save License</Run>
                            to store the license as a .lic file.</TextBlock>
                    </StackPanel>
                </Border>

                <!--  Templates Section  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="License Templates" />
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            Templates store a named set of license form values so you do not re-enter them for every license.
                        </TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Save:</Run>
                            Fill in the form, type a name in the Template box, and click
                            <Run FontWeight="SemiBold">Save Template</Run>.</TextBlock>
                        <TextBlock Margin="0,0,0,5" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Apply:</Run>
                            Select a template name in the dropdown. The form fills in automatically.</TextBlock>
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Delete:</Run>
                            Select a template and click <Run FontWeight="SemiBold">Delete</Run>.</TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            The expiration date is stored as days relative to the save date, so a template saved with an
                            expiration 30 days out always produces an expiration 30 days from the day you apply it.
                            Templates store the private key file path, never the key itself and never the key password.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  License Types Section  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="License Types" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,5"
                                FontWeight="SemiBold"
                                Text="Standard:" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,5"
                                TextWrapping="Wrap">
                                A normal license without trial-specific flags. Can be perpetual or with an expiration date.
                            </TextBlock>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,5"
                                FontWeight="SemiBold"
                                Text="Trial:" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,5"
                                TextWrapping="Wrap">
                                A time-limited license with the Trial flag set. Requires an expiration date.
                            </TextBlock>

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,10,5"
                                FontWeight="SemiBold"
                                Text="Custom:" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,0,5"
                                TextWrapping="Wrap">
                                Allows defining a custom license type. Use this for special licensing scenarios.
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Keys and Security Section  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="Keys and Security" />
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Private Key:</Run>
                            Used to sign licenses. Keep this secure and never distribute it with your application.</TextBlock>
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Public Key:</Run>
                            Distribute this with your application to validate licenses. It can only verify
                            signatures, not create them.</TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            Keys may be in PEM or XML format compatible with the Standard.Licensing library.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  Implementation Tips Section  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="15"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                            Text="Implementation Tips" />
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">• License Validation:</Run>
                            In your application, use the public key to verify the license signature
                            and check expiration dates.</TextBlock>
                        <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">• Custom Attributes:</Run>
                            Use the JSON attributes field to add any application-specific
                            license properties like feature flags, seat counts, or module access.</TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">• License Storage:</Run>
                            Allow users to import licenses via file selection
                            and store them in a secure location like the application data folder.</TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
