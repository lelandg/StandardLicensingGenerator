<mah:MetroWindow
    x:Class="StandardLicensingGenerator.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="About Standard Licensing Generator"
    Width="500"
    Height="300"
    MinWidth="425"
    MinHeight="340"
    Background="#F5F5F5"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="15"
            Background="#2E75B6">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="White"
                Text="About Standard Licensing Generator" />
        </Border>

        <!--  Content  -->
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Standard Licensing Generator" />

            <Grid Margin="0,5,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,5,5"
                    FontWeight="SemiBold"
                    Text="Version: " />
                <TextBlock
                    x:Name="VersionText"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,5"
                    Text="1.0.0" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    FontWeight="SemiBold"
                    Text="Build: " />
                <TextBlock
                    x:Name="BuildText"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0"
                    Text="1.0.0.0" />
            </Grid>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                A Windows desktop tool for generating licenses compatible with the Standard.Licensing library.
            </TextBlock>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                This tool allows you to create, sign, and save license files that can be validated in your applications.
            </TextBlock>
        </StackPanel>

        <!--  Footer with OK button  -->
        <Button
            Grid.Row="2"
            Width="80"
            Height="25"
            Margin="0,0,0,15"
            Click="OkButton_Click"
            Content="OK"
            IsDefault="True" />
    </Grid>
</mah:MetroWindow>
