    <Border x:Name="BorderBrush" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="Auto" />-->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Message Title  -->
            <!--<TextBlock
                x:Name="MessageTitle"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0"
                Padding="16,5,16,5"
                HorizontalAlignment="Stretch"
                Background="#2E75B6"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                TextAlignment="Left"
                TextWrapping="Wrap" />-->
            <!--  Icon  -->
            <Image
                x:Name="MessageIcon"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="45"
                Height="45"
                Margin="16,0,16,0"
                VerticalAlignment="Center" />

            <!--  Message Content  -->
            <TextBlock
                x:Name="MessageText"
                Grid.Row="0"
                Grid.Column="1"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!--  Buttons  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="16,0,16,16"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="YesButton"
                    Margin="0,0,5,0"
                    Click="YesButton_Click"
                    Content="_Yes"
                    IsDefault="True"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="NoButton"
                    Click="NoButton_Click"
                    Content="_No"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="OkButton"
                    Margin="0,0,5,0"
                    Click="OkButton_Click"
                    Content="_OK"
                    IsDefault="True"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CancelButton"
                    Click="CancelButton_Click"
                    Content="_Cancel"
                    IsCancel="True"
                    Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</mah:MetroWindow>
