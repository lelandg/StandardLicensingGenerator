<mah:MetroWindow
    x:Class="StandardLicensingGenerator.KeyPairGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:StandardLicensingGenerator"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Key Pair Generator"
    Width="500"
    Height="450"
    MinWidth="300"
    MinHeight="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="Key Size:" />
            <ComboBox
                x:Name="KeySizeBox"
                Grid.Row="0"
                Grid.Column="1"
                Width="100"
                Margin="10,0,0,0"
                HorizontalAlignment="Left">
                <ComboBoxItem Content="2048" />
                <ComboBoxItem Content="3072" />
                <ComboBoxItem Content="4096" />
            </ComboBox>
        </Grid>
        <Button
            Grid.Row="1"
            Width="150"
            Margin="0,10,0,0"
            Padding="5"
            Click="GenerateKeyPair_Click"
            Content="_Generate Key Pair" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="Password:" />

            <PasswordBox
                x:Name="PasswordBox"
                Grid.Column="1"
                Margin="10,0,10,0"
                PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBox
                x:Name="PasswordTextBox"
                Grid.Column="1"
                Margin="10,0,10,0"
                TextChanged="PasswordTextBox_TextChanged" />

            <Button
                Grid.Column="2"
                Padding="5"
                Click="ShowPasswordButton_Click"
                Content="S_how" />
        </Grid>

        <TextBox
            x:Name="ResultBox"
            Grid.Row="3"
            Height="Auto"
            Margin="0,10,0,0"
            IsReadOnly="True"
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="4"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Padding="5"
                Click="SavePrivateKey_Click"
                Content="Save P_rivate Key" />
            <Button
                Margin="0,0,10,0"
                Padding="5"
                Click="SavePublicKey_Click"
                Content="Save P_ublic Key" />
        </StackPanel>
        <StackPanel
            Grid.Row="5"
            Margin="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="InsertButton"
                Margin="0,10,10,0"
                Padding="5"
                Click="InsertButton_Click"
                Content="_Insert"
                IsEnabled="False" />
            <Button
                x:Name="CopyButton"
                Margin="10,10,0,0"
                Padding="5"
                Click="CopyButton_Click"
                Content="_Copy to Clipboard"
                IsEnabled="False"
                ToolTip="Copy private key file name to keyboard. Works across sessions." />
        </StackPanel>
    </Grid>
</mah:MetroWindow>